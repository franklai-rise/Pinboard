<Window x:Class="Pinboard.App.AiSessionReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="640" Height="490" MinWidth="510" MinHeight="330" WindowStartupLocation="CenterOwner" Background="#FBFBFD">
 <Grid Background="#FBFBFD"><Grid Margin="24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <Border Grid.Row="1" Background="White" BorderBrush="#E7E7EC" BorderThickness="1" CornerRadius="12" Padding="14">
   <TextBox x:Name="Report" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="12.5" Height="Auto" Padding="0"
     VerticalContentAlignment="Top" VerticalAlignment="Stretch" AcceptsReturn="True"
     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
  </Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button x:Name="CopyButton" Style="{StaticResource ToolbarButton}" Click="Copy_Click" Margin="0,0,10,0"/>
   <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="Close_Click"/>
  </StackPanel>
 </Grid></Grid>
</Window>
