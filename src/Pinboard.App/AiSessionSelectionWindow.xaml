<Window x:Class="Pinboard.App.AiSessionSelectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="24">
  <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock x:Name="ScopeLabel" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#6E6E73"/>
  <Border Background="#FFF7E8" CornerRadius="10" Padding="12" Margin="0,16,0,0">
   <TextBlock x:Name="WarningLabel" TextWrapping="Wrap" Foreground="#885500" FontSize="12"/>
  </Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
   <Button x:Name="CancelButton" IsCancel="True" IsDefault="True" MinWidth="78"/>
   <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" Margin="8,0,0,0" MinWidth="110"/>
  </StackPanel>
 </StackPanel>
</Window>
