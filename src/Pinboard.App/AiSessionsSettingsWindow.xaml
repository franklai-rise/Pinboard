<Window x:Class="Pinboard.App.AiSessionsSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="660" Height="700" MinHeight="580" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
 <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Foreground="#8E8E93" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,16"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
    <TextBlock x:Name="ArchiveLabel" FontWeight="SemiBold"/><TextBox x:Name="ArchiveBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,10"/>
    <DockPanel><CheckBox x:Name="PauseBox" Checked="Pause_Changed" Unchecked="Pause_Changed" VerticalAlignment="Center"/><Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Click="OpenFolder_Click"/></DockPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0"><StackPanel>
    <TextBlock Text="Google Drive" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="AccountLabel" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="QuotaLabel" Margin="0,6,0,0" Foreground="#8E8E93" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,14,0,0">
     <Button x:Name="ImportButton" Click="Import_Click" Margin="0,0,7,7"/>
     <Button x:Name="ConnectButton" Click="Connect_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,7,7"/>
     <Button x:Name="DisconnectButton" Click="Disconnect_Click" Margin="0,0,7,7"/>
     <Button x:Name="RetryButton" Click="Retry_Click" Margin="0,0,7,7"/>
     <Button x:Name="TestButton" Click="Test_Click" Margin="0,0,7,7"/>
    </WrapPanel>
    <TextBlock x:Name="ProgressLabel" Foreground="#007AFF" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border Background="#F0F6FE" CornerRadius="12" Padding="16" Margin="0,14,0,0"><StackPanel>
    <TextBlock x:Name="HelpHeading" FontWeight="SemiBold"/>
    <TextBlock x:Name="HelpText" Margin="0,9,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#6E6E73"/>
    <Button x:Name="ConsoleButton" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Console_Click"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Button x:Name="CloseButton" Grid.Row="2" HorizontalAlignment="Right" MinWidth="88" Click="Close_Click"/>
 </Grid>
</Window>
