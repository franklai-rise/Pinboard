<Window x:Class="Pinboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pinboard"
        Width="1180" Height="840"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <Grid Background="{StaticResource PageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="100" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#FAFAFC"
            BorderBrush="{StaticResource SoftSeparatorBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="14,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SidebarToggleButton"
                  Style="{StaticResource IconButton}"
                  Margin="0,0,8,0"
                  Click="SidebarToggleButton_Click"
                  ToolTip="{DynamicResource MainCollapseSidebarToolTip}">☰</Button>
          <Image Width="38" Height="38"
                 Source="/Pinboard;component/Assets/PinboardLogo.png"
                 Stretch="Uniform" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Pinboard" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource SecondaryText}" FontSize="10.5" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Row="0" Grid.Column="1"
                Margin="16,0,10,0"
                Height="38"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SoftSeparatorBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="11,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
            <TextBlock x:Name="HeaderDocumentTitle"
                       Text="{DynamicResource MainOpening}"
                       FontWeight="SemiBold"
                       MaxWidth="150"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Button Grid.Row="0" Grid.Column="2"
                Style="{StaticResource PrimaryToolbarButton}"
                Click="CaptureButton_Click"
                ToolTip="{DynamicResource MainCaptureToolTip}"
                Content="{DynamicResource MainCaptureButton}" />

        <Border Grid.Row="0" Grid.Column="4"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SoftSeparatorBrush}"
                BorderThickness="1"
                CornerRadius="11"
                Padding="2">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolbarButton}" Click="SearchButton_Click"
                    ToolTip="{DynamicResource MainSearchToolTip}"
                    Content="{DynamicResource MainSearchButton}" />
            <Button Style="{StaticResource ToolbarButton}" Click="LocateButton_Click"
                    ToolTip="{DynamicResource MainLocateToolTip}"
                    Content="{DynamicResource MainLocateLatest}" />
            <Button x:Name="AlwaysOnTopButton" Style="{StaticResource ToolbarButton}"
                    Click="AlwaysOnTopButton_Click" ToolTip="{DynamicResource MainTopmostToolTip}" />
            <Button x:Name="LanguageButton" Style="{StaticResource ToolbarButton}"
                    MinWidth="46" Click="LanguageButton_Click"
                    Content="{DynamicResource LanguageSwitchLabel}"
                    ToolTip="{DynamicResource LanguageSwitchToolTip}" />
            <Button Style="{StaticResource IconButton}" Click="SettingsButton_Click"
                    ToolTip="{DynamicResource MainSettingsToolTip}">⚙</Button>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SoftSeparatorBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="2">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolbarButton}" Click="NewButton_Click"
                    ToolTip="{DynamicResource MainNewBoardToolTip}"
                    Content="{DynamicResource MainNewBoardButton}" />
            <Button Style="{StaticResource ToolbarButton}" Click="OpenButton_Click"
                    ToolTip="{DynamicResource MainOpenToolTip}"
                    Content="{DynamicResource MainOpenButton}" />
            <Button Style="{StaticResource ToolbarButton}" Click="ImportButton_Click"
                    ToolTip="{DynamicResource MainImportToolTip}"
                    Content="{DynamicResource MainImportButton}" />
            <Border Width="1" Height="19" Background="{StaticResource SoftSeparatorBrush}"
                    Margin="5,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource ToolbarButton}" Click="ExportButton_Click"
                    Content="{DynamicResource MainExportButton}" />
            <Button Style="{StaticResource ToolbarButton}" Click="SaveCopyButton_Click"
                    Content="{DynamicResource MainSaveCopyButton}" />
            <Button Style="{StaticResource ToolbarButton}" Click="ResetInboxButton_Click"
                    ToolTip="{DynamicResource MainResetInboxToolTip}"
                    Content="{DynamicResource MainResetInboxButton}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="10,10,10,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="244" />
        <ColumnDefinition x:Name="SidebarGapColumn" Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarPanel"
              Grid.Column="0"
              Background="#FAFAFC"
              BorderBrush="{StaticResource SoftSeparatorBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="6,3,4,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource MainBoards}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="SidebarCountText" Grid.Column="1" Margin="6,0,4,0"
                       Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Height="30"
                    Padding="6,0" FontSize="11" Margin="0"
                    Click="NewProjectButton_Click" ToolTip="{DynamicResource MainNewProjectToolTip}"
                    Content="{DynamicResource MainNewProjectButton}" />
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30"
                    Click="NewButton_Click" ToolTip="{DynamicResource MainNewBoardToolTip}">＋</Button>
          </Grid>

          <Grid Grid.Row="1">
            <ListBox x:Name="SidebarList"
                     SelectionChanged="SidebarList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="GroupItem">
                            <Expander IsExpanded="{Binding Items[0].IsDefaultExpanded, Mode=OneWay}" Margin="0,0,0,7">
                              <Expander.Header>
                                <Grid Margin="4,4,0,3" Width="195">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryLabelBrush}" />
                                    <TextBlock Text="  ·  " Foreground="{StaticResource TertiaryLabelBrush}" />
                                    <TextBlock Text="{Binding Items[0].ProjectBoardCount}" FontSize="10.5"
                                               Foreground="{StaticResource TertiaryLabelBrush}" />
                                  </StackPanel>
                                  <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                          Width="28" Height="28" Margin="0" FontSize="14"
                                          Content="＋" ToolTip="{DynamicResource MainProjectNewBoardToolTip}"
                                          CommandParameter="{Binding Items[0].ProjectName}"
                                          Visibility="{Binding Items[0].CanCreateBoard, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Click="NewBoardForProjectButton_Click" />
                                </Grid>
                              </Expander.Header>
                              <ItemsPresenter />
                            </Expander>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Margin" Value="0,1" />
                  <Setter Property="Padding" Value="10,9" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SidebarItemBorder"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SidebarItemBorder" Property="Background"
                                    Value="{StaticResource ControlBrush}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SidebarItemBorder" Property="Background"
                                    Value="{StaticResource AccentSoftBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                      <Setter Property="IsHitTestVisible" Value="False" />
                      <Setter Property="Cursor" Value="Arrow" />
                      <Setter Property="Opacity" Value="0.65" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding Path}" MouseRightButtonUp="BoardItem_MouseRightButtonUp" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CaptureTargetGlow" Grid.ColumnSpan="3"
                            Margin="-2" BorderThickness="1.5" CornerRadius="11"
                            Background="#0E7C3AED" Visibility="Collapsed"
                            IsHitTestVisible="False">
                      <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#6C5CE7" Offset="0" />
                          <GradientStop Color="#00C6FF" Offset="0.52" />
                          <GradientStop Color="#D946EF" Offset="1" />
                        </LinearGradientBrush>
                      </Border.BorderBrush>
                      <Border.Effect>
                        <DropShadowEffect Color="#8B5CF6" BlurRadius="17" ShadowDepth="0" Opacity="0.82" />
                      </Border.Effect>
                    </Border>
                    <Border x:Name="ActiveIndicator" Grid.Column="0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="2" Margin="0,2,0,2" Visibility="Collapsed" />
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="BoardTitleText" Text="{Binding Title}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <Border x:Name="CaptureTargetBadge" Grid.Column="1" Visibility="Collapsed"
                              Margin="7,0,0,0" Padding="5,2" CornerRadius="7"
                              Background="#1A6C5CE7" BorderBrush="#996C5CE7" BorderThickness="1"
                              ToolTip="{DynamicResource SidebarCaptureTargetToolTip}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="✦" Foreground="#6C5CE7" FontSize="10" Margin="0,0,3,0" />
                          <TextBlock Text="{DynamicResource SidebarCaptureTargetBadge}" Foreground="#5B45D6"
                                     FontSize="9.5" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Margin="0,3,0,0"
                                 Style="{StaticResource SecondaryText}"
                                 FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Button x:Name="BoardActionsButton" Grid.Column="2"
                            Style="{StaticResource IconButton}" Width="26" Height="26"
                            Margin="3,0,0,0" FontSize="16" Content="⋯"
                            ToolTip="{DynamicResource MainBoardActionsToolTip}" CommandParameter="{Binding}"
                            Click="BoardActionsButton_Click" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                 Value="True">
                      <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                      <Setter TargetName="BoardTitleText" Property="FontWeight" Value="Normal" />
                      <Setter TargetName="BoardTitleText" Property="Foreground"
                              Value="{StaticResource TertiaryLabelBrush}" />
                      <Setter TargetName="BoardActionsButton" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCaptureTarget}" Value="True">
                      <Setter TargetName="CaptureTargetGlow" Property="Visibility" Value="Visible" />
                      <Setter TargetName="CaptureTargetBadge" Property="Visibility" Value="Visible" />
                      <Setter TargetName="BoardTitleText" Property="Foreground" Value="#5B45D6" />
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="CaptureTargetGlow"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.46" To="1" Duration="0:0:1.35" />
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="SidebarEmptyPanel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
              <TextBlock Text="{DynamicResource MainNoBoards}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource MainNoBoardsHelp}"
                         Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Style="{StaticResource InsetCard}" Padding="10,8" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource MainProjectLibrary}" Style="{StaticResource SecondaryText}" FontSize="10" />
              <TextBlock x:Name="SidebarLibraryText" Margin="0,3,0,0"
                         FontSize="10.5" Foreground="{StaticResource SecondaryLabelBrush}"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource SoftSeparatorBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="1">
        <wv2:WebView2 x:Name="CanvasView" DefaultBackgroundColor="#F5F5F7" />
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"
                   VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="{DynamicResource MainStarting}" Style="{StaticResource SecondaryText}"
                     MaxWidth="520" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top">
        <TextBlock x:Name="CaptureTargetText" Style="{StaticResource SecondaryText}" />
      </Border>
    </Grid>
  </Grid>
</Window>
