<Window x:Class="Pinboard.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pinboard" Width="1240" Height="820" MinWidth="800" MinHeight="580" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></Window.Resources>
 <Grid Background="{StaticResource SurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
  <Border Background="#FAFAFB" BorderBrush="{StaticResource SoftSeparatorBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="18,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
     <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButton}" Click="SidebarToggleButton_Click" ToolTip="{DynamicResource MainCollapseSidebarToolTip}" AutomationProperties.Name="Toggle sidebar">
      <Path Data="M1,2 H19 V18 H1 Z M7,2 V18" Stroke="{StaticResource SecondaryLabelBrush}" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform" />
     </Button>
     <Image Width="30" Height="30" Margin="10,0,9,0" Source="/Pinboard;component/Assets/PinboardLogo.png" />
     <TextBlock Text="Pinboard" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
     <TextBlock x:Name="HeaderDocumentTitle" Text="{DynamicResource LibraryTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     <TextBlock x:Name="HeaderSaveStatus" Text="{DynamicResource LibrarySubtitle}" FontSize="10.5" Margin="0,3,0,0" Foreground="{StaticResource SecondaryLabelBrush}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Style="{StaticResource IconButton}" Click="SearchButton_Click" ToolTip="{DynamicResource MainSearchToolTip}" AutomationProperties.Name="Search">
      <Path Data="M15,8 A7,7 0 1 1 1,8 A7,7 0 1 1 15,8 M13,13 L19,19" Width="19" Height="19" Stroke="{StaticResource LabelBrush}" StrokeThickness="1.5" Stretch="Uniform" />
     </Button>
     <Button Style="{StaticResource ToolbarButton}" Click="CaptureButton_Click" ToolTip="{DynamicResource MainCaptureToolTip}" Margin="6,0" Foreground="{StaticResource AccentBrush}">
      <StackPanel Orientation="Horizontal">
       <Path Data="M1,5 H5 L7,2 H13 L15,5 H19 V17 H1 Z M14,11 A4,4 0 1 1 6,11 A4,4 0 1 1 14,11" Width="20" Height="18" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,7,0" />
       <TextBlock Text="{DynamicResource CaptureShort}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
     <Button Style="{StaticResource IconButton}" Click="MoreButton_Click" ToolTip="{DynamicResource MainMoreToolTip}" AutomationProperties.Name="More">⋯</Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="248" /><ColumnDefinition x:Name="SidebarGapColumn" Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="#F6F6F8" Padding="12,18,10,12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <Grid Margin="8,0,4,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource LibraryTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryLabelBrush}" VerticalAlignment="Center" />
      <TextBlock x:Name="SidebarCountText" Grid.Column="1" FontSize="10" Foreground="{StaticResource TertiaryLabelBrush}" Margin="6,0,6,0" VerticalAlignment="Center" />
      <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Click="LibraryAddButton_Click" ToolTip="{DynamicResource LibraryCreate}">+</Button>
     </Grid>
     <Grid Grid.Row="1">
      <ListBox x:Name="SidebarList" SelectionChanged="SidebarList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.GroupStyle>
        <GroupStyle>
         <GroupStyle.Panel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></GroupStyle.Panel>
         <GroupStyle.ContainerStyle><Style TargetType="GroupItem">
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
           <Expander IsExpanded="{Binding Items[0].IsDefaultExpanded, Mode=OneWay}" Margin="0,0,0,14" Loaded="SidebarGroup_Loaded" Expanded="SidebarGroup_Changed" Collapsed="SidebarGroup_Changed">
            <Expander.Header>
             <Grid Width="186" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryLabelBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="15" Content="+" ToolTip="{DynamicResource LibraryCreate}" CommandParameter="{Binding Items[0].ProjectName}"
               Visibility="{Binding Items[0].CanCreateBoard, Converter={StaticResource BooleanToVisibilityConverter}}" Click="NewBoardForProjectButton_Click" />
             </Grid>
            </Expander.Header>
            <ItemsPresenter />
           </Expander>
          </ControlTemplate></Setter.Value></Setter>
         </Style></GroupStyle.ContainerStyle>
        </GroupStyle>
       </ListBox.GroupStyle>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,1" /><Setter Property="Padding" Value="10,8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#ECEDEF" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DFEBFA" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value=".55" /></DataTrigger></Style.Triggers>
       </Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Grid ToolTip="{Binding Path}" MouseRightButtonUp="BoardItem_MouseRightButtonUp">
         <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource SecondaryLabelBrush}" VerticalAlignment="Center" />
         <TextBlock x:Name="BoardTitleText" Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
         <Ellipse x:Name="CaptureDot" Grid.Column="2" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="8,0,5,0" Visibility="Collapsed" ToolTip="{DynamicResource SidebarCaptureTargetToolTip}" VerticalAlignment="Center" />
         <Button x:Name="BoardActionsButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="22" Height="22" Margin="0" Opacity="0" Content="⋯" FontSize="17" ToolTip="{DynamicResource MainBoardActionsToolTip}" CommandParameter="{Binding}" Click="BoardActionsButton_Click" />
        </Grid>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="BoardActionsButton" Property="Opacity" Value="1" /></DataTrigger>
         <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="BoardActionsButton" Property="Opacity" Value="1" /></DataTrigger>
         <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="BoardTitleText" Property="FontWeight" Value="Medium" /><Setter TargetName="BoardTitleText" Property="Foreground" Value="#174A85" /></DataTrigger>
         <DataTrigger Binding="{Binding IsCaptureTarget}" Value="True"><Setter TargetName="CaptureDot" Property="Visibility" Value="Visible" /></DataTrigger>
         <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter TargetName="BoardActionsButton" Property="Visibility" Value="Collapsed" /></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="SidebarEmptyPanel" Margin="14,30" Visibility="Collapsed"><TextBlock Text="{DynamicResource LibrarySubtitle}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" /></StackPanel>
     </Grid>
     <Button Grid.Row="2" Style="{StaticResource ToolbarButton}" Height="38" Click="OpenLibraryButton_Click" Margin="2,12,0,0">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource SecondaryLabelBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
       <TextBlock x:Name="SidebarLibraryText" FontSize="10" Foreground="{StaticResource SecondaryLabelBrush}" MaxWidth="172" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      </StackPanel>
     </Button>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource SoftSeparatorBrush}" />
   <ContentControl x:Name="CanvasHost" Grid.Column="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
  <Border Grid.Row="2" BorderBrush="{StaticResource SoftSeparatorBrush}" BorderThickness="0,1,0,0" Background="#FAFAFB">
   <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Text="{DynamicResource MainStarting}" FontSize="10" Foreground="{StaticResource SecondaryLabelBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
    <TextBlock x:Name="CaptureTargetText" Grid.Column="1" FontSize="10" Foreground="{StaticResource SecondaryLabelBrush}" VerticalAlignment="Center" />
   </Grid>
  </Border>
 </Grid>
</Window>
