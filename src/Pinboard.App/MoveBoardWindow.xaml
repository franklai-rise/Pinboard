<Window x:Class="Pinboard.App.MoveBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowMoveBoardTitle}"
        Width="460" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="26,24,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource AccentSoftBrush}">
        <TextBlock Text="→" Foreground="{StaticResource AccentBrush}" FontSize="20"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource MoveBoardHeading}" Style="{StaticResource WindowTitleText}" />
        <TextBlock Text="{DynamicResource MoveBoardDescription}" Style="{StaticResource SecondaryText}" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,18" Padding="22,18">
      <StackPanel>
        <TextBlock Text="{DynamicResource CommonBoard}" Style="{StaticResource SecondaryText}" />
        <TextBlock x:Name="BoardTitleText" Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="CurrentProjectText" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
        <TextBlock Text="{DynamicResource DestinationProjectLabel}" Style="{StaticResource SectionTitleText}" Margin="0,19,0,0" />
        <ComboBox x:Name="ProjectBox" Margin="0,9,0,0" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsCancel="True" Content="{DynamicResource CommonCancel}" />
      <Button Style="{StaticResource PrimaryButton}" Click="MoveButton_Click"
              Margin="7,0,3,0" MinWidth="88" IsDefault="True"
              Content="{DynamicResource MoveBoardButton}" />
    </StackPanel>
  </Grid>
</Window>
