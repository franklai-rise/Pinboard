<Window x:Class="Pinboard.App.NewBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowNewBoardTitle}"
        Width="460" Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="26,24,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource AccentSoftBrush}">
        <TextBlock Text="＋" Foreground="{StaticResource AccentBrush}" FontSize="22"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource NewBoardHeading}" Style="{StaticResource WindowTitleText}" />
        <TextBlock Text="{DynamicResource NewBoardDescription}"
                   Style="{StaticResource SecondaryText}" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,18" Padding="22,18">
      <StackPanel>
        <TextBlock Text="{DynamicResource BoardNameLabel}" Style="{StaticResource SectionTitleText}" />
        <TextBox x:Name="BoardTitleBox" Margin="0,9,0,0" />

        <TextBlock Text="{DynamicResource ProjectLabel}" Style="{StaticResource SectionTitleText}" Margin="0,19,0,0" />
        <ComboBox x:Name="ProjectBox" Margin="0,9,0,0" IsEditable="True"
                  IsTextSearchEnabled="True" StaysOpenOnEdit="True">
          <ComboBox.Style>
            <Style TargetType="ComboBox">
              <Setter Property="Height" Value="38" />
              <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ComboBox">
                    <Grid>
                      <Border x:Name="ComboBorder"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="9" />
                      <ToggleButton Focusable="False" ClickMode="Press"
                                    Background="Transparent" BorderThickness="0"
                                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" />
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>
                      <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}"
                               Margin="12,1,36,1" Padding="0"
                               Background="Transparent" BorderThickness="0"
                               VerticalContentAlignment="Center"
                               Foreground="{TemplateBinding Foreground}"
                               CaretBrush="{StaticResource AccentBrush}" />
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                            Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource SecondaryLabelBrush}"
                            StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            IsHitTestVisible="False" />
                      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                             Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                             Focusable="False">
                        <Border Margin="0,5,0,0"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="260"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SoftSeparatorBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="3"
                                Effect="{StaticResource FloatingShadow}">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel IsItemsHost="True" />
                          </ScrollViewer>
                        </Border>
                      </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="ComboBorder" Property="BorderBrush"
                                Value="{StaticResource AccentBrush}" />
                        <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ComboBox.Style>
        </ComboBox>
        <TextBlock Margin="0,7,0,0"
                   Text="{DynamicResource ProjectChoiceHelp}"
                   Style="{StaticResource SecondaryText}" />

        <TextBlock x:Name="ValidationText" Margin="0,15,0,0"
                   Foreground="#D70015" Visibility="Collapsed" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsCancel="True" Content="{DynamicResource CommonCancel}" />
      <Button Style="{StaticResource PrimaryButton}" Click="CreateButton_Click"
              Margin="7,0,3,0" MinWidth="94" IsDefault="True"
              Content="{DynamicResource CreateAndOpen}" />
    </StackPanel>
  </Grid>
</Window>
