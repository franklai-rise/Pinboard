<Window x:Class="Pinboard.App.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowNewProjectTitle}"
        Width="450" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="26,24,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource AccentSoftBrush}">
        <TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" FontSize="20"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource NewProjectHeading}" Style="{StaticResource WindowTitleText}" />
        <TextBlock Text="{DynamicResource NewProjectDescription}"
                   Style="{StaticResource SecondaryText}" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,18" Padding="22,18">
      <StackPanel>
        <TextBlock Text="{DynamicResource ProjectNameLabel}" Style="{StaticResource SectionTitleText}" />
        <TextBox x:Name="ProjectNameBox" Margin="0,9,0,0" />
        <TextBlock Margin="0,7,0,0" Text="{DynamicResource NewProjectHelp}"
                   Style="{StaticResource SecondaryText}" />
        <TextBlock x:Name="ValidationText" Margin="0,15,0,0"
                   Foreground="#D70015" Visibility="Collapsed" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsCancel="True" Content="{DynamicResource CommonCancel}" />
      <Button Style="{StaticResource PrimaryButton}" Click="CreateButton_Click"
              Margin="7,0,3,0" MinWidth="88" IsDefault="True"
              Content="{DynamicResource CreateProject}" />
    </StackPanel>
  </Grid>
</Window>
