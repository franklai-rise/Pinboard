<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Pinboard.ico</ApplicationIcon>
    <AssemblyName>Pinboard</AssemblyName>
    <RootNamespace>Pinboard.App</RootNamespace>
    <Version>0.7.3</Version>
    <Authors>Pinboard contributors</Authors>
    <Description>Offline screenshot infinite canvas with PixPin delivery.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PinboardLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\web\dist\**\*"
                      LogicalName="Pinboard.Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
