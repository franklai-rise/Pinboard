<Window x:Class="Pinboard.App.RenameBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowRenameBoardTitle}"
        Width="560" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="26,24,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource AccentSoftBrush}">
        <TextBlock Text="✎" Foreground="{StaticResource AccentBrush}" FontSize="19"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource RenameBoardHeading}" Style="{StaticResource WindowTitleText}" />
        <TextBlock Text="{DynamicResource RenameBoardDescription}" Style="{StaticResource SecondaryText}"
                   TextWrapping="Wrap" MaxWidth="440" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,18" Padding="22,18">
      <StackPanel>
        <TextBlock Text="{DynamicResource RenameBoardNameLabel}" Style="{StaticResource SectionTitleText}" />
        <TextBox x:Name="DisplayNameBox" Margin="0,9,0,0" MaxLength="120" />
        <TextBlock Text="{DynamicResource RenameBoardPathLabel}" Style="{StaticResource SectionTitleText}"
                   Margin="0,18,0,0" />
        <TextBlock x:Name="ActualPathText" Margin="0,7,0,0" TextWrapping="Wrap"
                   Style="{StaticResource SecondaryText}" />
        <TextBlock x:Name="ValidationText" Margin="0,12,0,0" Foreground="#D70015"
                   Visibility="Collapsed" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsCancel="True" Content="{DynamicResource CommonCancel}" />
      <Button Style="{StaticResource PrimaryButton}" Click="RenameButton_Click"
              Margin="7,0,3,0" MinWidth="88" IsDefault="True"
              Content="{DynamicResource RenameBoardSave}" />
    </StackPanel>
  </Grid>
</Window>
