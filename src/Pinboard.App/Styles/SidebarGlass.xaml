<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Local, vector-only glass treatment: no backdrop capture, blur or idle timers. -->
  <LinearGradientBrush x:Key="SidebarGlassBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F8FAFE" Offset="0" /><GradientStop Color="#F0F3F9" Offset=".55" /><GradientStop Color="#F7F7FA" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SidebarGlassHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEFFFFFF" Offset="0" /><GradientStop Color="#80FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SidebarGlassSelection" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F5FFFFFF" Offset="0" /><GradientStop Color="#E5E5F1FF" Offset=".45" /><GradientStop Color="#E0D6E8FF" Offset="1" />
  </LinearGradientBrush>
  <Style x:Key="SidebarGlassRow" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="2,2" /><Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="42" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ListBoxItem">
        <Grid SnapsToDevicePixels="True">
          <Border x:Name="Glass" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" />
          <Border x:Name="Rim" Margin="1" CornerRadius="10" BorderThickness="0,1,0,0" BorderBrush="White" Opacity="0" IsHitTestVisible="False" />
          <Border x:Name="SelectionMark" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="4,0,0,0" Background="{StaticResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          <Border x:Name="KeyboardRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="11" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Glass" Property="Background" Value="{StaticResource SidebarGlassHover}" />
            <Setter TargetName="Glass" Property="BorderBrush" Value="#C9FFFFFF" /><Setter TargetName="Rim" Property="Opacity" Value=".8" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Glass" Property="Background" Value="{StaticResource SidebarGlassSelection}" />
            <Setter TargetName="Glass" Property="BorderBrush" Value="#8DA8CFF5" /><Setter TargetName="Rim" Property="Opacity" Value="1" />
            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
            <Setter TargetName="Glass" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            <Setter TargetName="Rim" Property="Opacity" Value="0" />
          </MultiDataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="SidebarDisclosure" TargetType="ToggleButton">
    <Setter Property="MinHeight" Value="34" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="ForceCursor" Value="True" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ToggleButton">
        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
          <Border x:Name="ArrowButton" Width="24" Height="24" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Margin="2,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" RenderTransformOrigin=".5,.5">
            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
            <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource SecondaryLabelBrush}" StrokeThickness="1.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
              <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
            </Path>
          </Border>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="HitArea" Property="Background" Value="{StaticResource SidebarGlassHover}" />
            <Setter TargetName="HitArea" Property="BorderBrush" Value="#75B8D3EF" />
            <Setter TargetName="ArrowButton" Property="Background" Value="#E6E1EFFF" />
            <Setter TargetName="ArrowButton" Property="BorderBrush" Value="#DCFFFFFF" />
            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentBrush}" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="HitArea" Property="Background" Value="#CCDCEBFB" />
            <Setter TargetName="ArrowButton" Property="Background" Value="#FFC4DDF9" />
            <Setter TargetName="ArrowButton" Property="BorderBrush" Value="#FF95BCE8" />
            <Setter TargetName="Arrow" Property="Stroke" Value="#174A85" />
          </Trigger>
          <!-- Render-only scale leaves hit targets and neighbouring rows stationary. -->
          <MultiDataTrigger><MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
            <Setter TargetName="ArrowButton" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06" /></Setter.Value></Setter>
          </MultiDataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
            <Setter TargetName="ArrowButton" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".94" ScaleY=".94" /></Setter.Value></Setter>
          </MultiDataTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitArea" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
            <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="90" Duration="0:0:0.16" FillBehavior="Stop" /></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
            <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="90" To="0" Duration="0:0:0.16" FillBehavior="Stop" /></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
          </MultiDataTrigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Cursor" Value="Arrow" /><Setter TargetName="HitArea" Property="Opacity" Value=".45" />
            <Setter TargetName="HitArea" Property="Background" Value="Transparent" /><Setter TargetName="HitArea" Property="BorderBrush" Value="Transparent" />
            <Setter TargetName="ArrowButton" Property="Background" Value="Transparent" /><Setter TargetName="ArrowButton" Property="BorderBrush" Value="Transparent" />
            <Setter TargetName="ArrowButton" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource SecondaryLabelBrush}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="SidebarGlassGroup" TargetType="Expander">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Expander">
        <StackPanel>
          <Grid Margin="2,0,2,4">
            <!-- Header overlay has no background; only its independent + button intercepts input. -->
            <ToggleButton Style="{StaticResource SidebarDisclosure}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Name}" />
            <ContentPresenter ContentSource="Header" Margin="30,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
          </Grid>
          <ContentPresenter x:Name="GroupContent" Visibility="Collapsed" />
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="GroupContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
