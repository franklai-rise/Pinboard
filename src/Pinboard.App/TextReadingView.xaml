<UserControl x:Class="Pinboard.App.TextReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F7" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
             Loaded="View_Loaded">
  <UserControl.Resources>
    <Style x:Key="ReadingCard" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Background="White" BorderBrush="#E7E7EC" BorderThickness="1"
                    CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#CBCBD2" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#007AFF" />
                <Setter TargetName="Card" Property="Background" Value="#F6FAFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#007AFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#E7E7EC" BorderThickness="1" CornerRadius="11" Padding="10,4" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock Text="⌕" FontSize="23" Foreground="#8E8E93" Margin="0,0,9,0" VerticalAlignment="Center" />
          <TextBox x:Name="FilterBox" Background="Transparent" BorderThickness="0" FontSize="14"
                   Padding="0" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
        </DockPanel>
      </Border>
      <ComboBox x:Name="OrderBox" Grid.Column="1" Width="146" SelectedIndex="0" SelectionChanged="OrderBox_SelectionChanged" />
    </Grid>
    <DockPanel Grid.Row="1" Margin="2,12,2,14">
      <CheckBox x:Name="CollapseDuplicatesBox" DockPanel.Dock="Right" Margin="14,0,0,0"
                VerticalAlignment="Center" Checked="CollapseDuplicates_Changed" Unchecked="CollapseDuplicates_Changed" />
      <CheckBox x:Name="FavoritesOnlyBox" DockPanel.Dock="Right" Margin="14,0,0,0"
                VerticalAlignment="Center" Checked="FavoritesOnly_Changed" Unchecked="FavoritesOnly_Changed" />
      <TextBlock x:Name="CountLabel" Foreground="#6E6E73" FontSize="12" VerticalAlignment="Center" />
    </DockPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.43*" MinWidth="240" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="0.57*" MinWidth="260" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="ClipsList" Background="Transparent" BorderThickness="0" Padding="0"
               ItemContainerStyle="{StaticResource ReadingCard}" HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="ClipsList_SelectionChanged"
               PreviewKeyDown="ClipsList_PreviewKeyDown">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding RepeatsLabel}" Foreground="#007AFF" FontSize="11" Margin="8,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding FavoriteLabel}" Foreground="#FF9F0A" FontSize="12" Margin="8,0,0,0" />
                <TextBlock Text="{Binding TimestampLabel}" Foreground="#8E8E93" FontSize="11" />
              </DockPanel>
              <TextBlock Text="{Binding Excerpt}" FontSize="14" Foreground="#1D1D1F" TextWrapping="Wrap"
                         MaxHeight="84" LineHeight="21" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyLabel" TextWrapping="Wrap" Foreground="#8E8E93" FontSize="14" Margin="12,32,12,0"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
      <Border Grid.Column="2" Background="White" BorderBrush="#E7E7EC" BorderThickness="1" CornerRadius="16" Padding="20,18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button x:Name="FavoriteButton" DockPanel.Dock="Right" Content="☆" FontSize="21"
                    MinWidth="32" Width="34" Height="32" Padding="0" Margin="8,0,0,0"
                    Background="Transparent" BorderThickness="0" Click="Favorite_Click" />
            <TextBlock x:Name="DetailTimestamp" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center" />
          </DockPanel>
          <RichTextBox x:Name="FullTextBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                       Padding="0" FontSize="16" Foreground="#1D1D1F" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled" IsDocumentEnabled="False"
                       PreviewKeyDown="FullTextBox_PreviewKeyDown" />
          <TextBlock x:Name="SelectHint" Grid.Row="1" TextWrapping="Wrap" Foreground="#8E8E93" FontSize="15"
                     Margin="0,24,0,0" VerticalAlignment="Top" />
          <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="ShowOnCanvasButton" DockPanel.Dock="Right" Click="ShowOnCanvas_Click" />
            <Button x:Name="CopyButton" HorizontalAlignment="Left" Click="Copy_Click" />
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
